/*============================================================================
 * 通用字形分发 — 供渲染端调用 (ST7735 等驱动只依赖 font.h)
 *==========================================================================*/
const uint16_t* font_get_glyph(const FontDef& font, uint8_t ch) {
#if USE_FULLFONT_STY1_11X18
    if (&font == &FULLFONT_STY1_11x18) return font_lookup_fullfont_sty1_11x18(ch);
#endif
#if USE_FULLFONT_STY1_16X26
    if (&font == &FULLFONT_STY1_16x26) return font_lookup_fullfont_sty1_16x26(ch);
#endif
#if USE_FULLFONT_STY1_7X10
    if (&font == &FULLFONT_STY1_7x10) return font_lookup_fullfont_sty1_7x10(ch);
#endif
#if USE_NUMFONT_STY1_11X18
    if (&font == &NUMFONT_STY1_11x18) return font_lookup_numfont_sty1_11x18(ch);
#endif
#if USE_NUMFONT_STY1_9X16
    if (&font == &NUMFONT_STY1_9X16) return font_lookup_numfont_sty1_9x16(ch);
#endif
#if USE_FULLFONT_STY1_9X16
    if (&font == &FULLFONT_STY1_9X16) return font_lookup_fullfont_sty1_9x16(ch);
#endif
    return nullptr;
}

const uint16_t* font_get_glyph_unicode(const FontDef& font, uint16_t uni) {
    (void)font; (void)uni;
    return nullptr;
}
