static const uint16_t* font_lookup_fullfont_sty1_16x26(uint8_t ch) {
    switch (ch) {
#define FONT_CASE(cp) case cp: return g_fullfont_sty1_16x26_cp##cp;
        FULLFONT_STY1_16X26_CHARS(FONT_CASE)   /* <- 工程的编译清单 */
#undef FONT_CASE
        default: return nullptr;   /* 未编译的字符 -> 渲染端跳过 */
    }
}

